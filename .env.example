# ---- Site lock screen ----
# The shared password for the "enter the key to my heart…" gate. Optional —
# defaults to the built-in key if unset.
# SITE_PASSWORD=edamamesweetpea0609

# ---- Shared album + timeline (Vercel Blob) ----
# Enables the shared, permanent "Pictures of us" gallery, shared photobooth
# strips, and user-added timeline events (visible to everyone who has the site
# password). Two ways to connect:
#   1. Vercel dashboard → Storage → Blob → Connect to Project (OIDC): sets
#      BLOB_STORE_ID automatically. Nothing to paste. (Recommended.)
#   2. A classic read-write token (BLOB_READ_WRITE_TOKEN).
# The app treats EITHER as "configured". Without one, photos/strips/memories
# fall back to on-device browser storage.
# For local dev against the shared store: `vercel env pull .env.local`.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# BLOB_STORE_ID=store_xxxxxxxx

# ---- Next.js (client) ----
# Where the PartyKit realtime server lives.
#   local dev : 127.0.0.1:1999  (the default when unset)
#   production: <project>.<user>.partykit.dev  (from `partykit deploy`)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# ---- PartyKit (server-side vars) ----
# Set these on the PartyKit deployment, NOT in Next. Locally, `partykit dev`
# reads a .env file in the project root; in prod use `partykit env`.
#
# TURN is optional but strongly recommended so calls connect across different
# networks/NATs. Use Cloudflare TURN, Metered, Twilio, etc. Comma-separate
# multiple URLs.
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# Optional STUN override (defaults to Google STUN). Comma-separated.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
