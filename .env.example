# ---- Site login (two users) ----
# Two accounts gate the site. gurm = pink ("you"), ram = blue ("me").
# Passwords + the token-signing secret are overridable here (optional; they
# default to the built-in values). Never shipped to the browser bundle.
# GURM_PASSWORD=sweetpea09
# RAM_PASSWORD=edamame06
# SITE_AUTH_SECRET=change-me-to-a-long-random-string

# ---- Shared album + timeline (Vercel Blob) ----
# Enables the shared, permanent "Pictures of us" gallery, shared photobooth
# strips, and user-added timeline events (visible to everyone who has the site
# password). Two ways to connect:
#   1. Vercel dashboard → Storage → Blob → Connect to Project (OIDC): sets
#      BLOB_STORE_ID automatically. Nothing to paste. (Recommended.)
#   2. A classic read-write token (BLOB_READ_WRITE_TOKEN).
# The app treats EITHER as "configured". Without one, photos/strips/memories
# fall back to on-device browser storage.
# For local dev against the shared store: `vercel env pull .env.local`.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# BLOB_STORE_ID=store_xxxxxxxx

# ---- Next.js (client) ----
# Where the realtime server (Cloudflare Worker / PartyServer) lives.
#   local dev : 127.0.0.1:8787  (the default when unset; `npm run party:dev`)
#   production: mygurm-party.<your-subdomain>.workers.dev  (from `wrangler deploy`)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:8787

# ---- Realtime server (Cloudflare Worker) vars/secrets ----
# Set these on the WORKER, not in Next. STUN_URLS is a plain var (in
# wrangler.jsonc). TURN creds are secrets:
#   npx wrangler secret put TURN_URL
#   npx wrangler secret put TURN_USERNAME
#   npx wrangler secret put TURN_CREDENTIAL
# TURN is optional but strongly recommended so calls connect across different
# networks/NATs (Cloudflare TURN, Metered, Twilio, …). Comma-separate URLs.
